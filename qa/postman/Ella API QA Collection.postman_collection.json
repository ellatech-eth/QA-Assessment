                  "    pm.expect(product).to.have.property(\"id\");",
                  "    pm.collectionVariables.set(\"productId\", product.id);",
                  "});",
                  "pm.test(\"Response has correct name\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var product = jsonData.data || jsonData;",
                  "    pm.expect(product.name).to.eql(pm.collectionVariables.get(\"uniqueProductName\"));",
                  "});",
                  "pm.test(\"Response has correct price\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var product = jsonData.data || jsonData;",
                  "    pm.expect(product.price).to.eql(29.99);",
                  "});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const uniqueName = \"Product_\" + Date.now();\npm.collectionVariables.set(\"uniqueProductName\", uniqueName);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{uniqueProductName}}\",\n  \"price\": 29.99,\n  \"stock\": 100,\n  \"quantity\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response has product id\", function () {",
                  "    var body = pm.response.json();",
                  "    // Handle both array response and {data: [...]} envelope",
                  "    var arr = Array.isArray(body) ? body : (Array.isArray(body.data) ? body.data : [body.data || body]);",
                  "    var targetId = parseInt(pm.collectionVariables.get(\"productId\"));",
                  "    var product = arr.find(function(p) { return p && p.id === targetId; });",
                  "    if (!product) { product = arr[0]; }",
                  "    pm.expect(product).to.be.an(\"object\");",
                  "    pm.expect(product).to.have.property(\"id\");",
                  "});",
                  "pm.test(\"Response has correct name\", function () {",
                  "    var body = pm.response.json();",
                  "    var arr = Array.isArray(body) ? body : (Array.isArray(body.data) ? body.data : [body.data || body]);",
                  "    var targetId = parseInt(pm.collectionVariables.get(\"productId\"));",
                  "    var product = arr.find(function(p) { return p && p.id === targetId; });",
                  "    if (!product) { product = arr[0]; }",
                  "    var expectedName = pm.collectionVariables.get(\"uniqueProductName\");",
                  "    pm.expect(product.name).to.eql(expectedName);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:4000/products",
