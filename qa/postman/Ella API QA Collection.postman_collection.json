      "name": "Products",
      "item": [
        {
          "name": "Create Product - valid",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response has product id\", function () {",
                  "    var jsonData = pm.response.json();",
