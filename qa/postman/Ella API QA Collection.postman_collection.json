                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response has transaction id\", function () {",
                  "    var body = pm.response.json();",
                  "    var arr = Array.isArray(body) ? body : (Array.isArray(body.data) ? body.data : [body.data || body]);",
                  "    var targetId = parseInt(pm.collectionVariables.get(\"transactionId\"));",
                  "    var tx = arr.find(function(t) { return t && t.id === targetId; });",
                  "    if (!tx) { tx = arr[0]; }",
                  "    pm.expect(tx).to.be.an(\"object\");",
                  "    pm.expect(tx).to.have.property(\"id\");",
                  "});",
                  "pm.test(\"Response has correct userId\", function () {",
                  "    var body = pm.response.json();",
                  "    var arr = Array.isArray(body) ? body : (Array.isArray(body.data) ? body.data : [body.data || body]);",
                  "    var targetId = parseInt(pm.collectionVariables.get(\"transactionId\"));",
                  "    var tx = arr.find(function(t) { return t && t.id === targetId; });",
                  "    if (!tx) { tx = arr[0]; }",
                  "    pm.expect(tx).to.be.an(\"object\");",
                  "    // API returns nested user object OR flat userId",
                  "    var hasUser = tx.hasOwnProperty(\"user\") || tx.hasOwnProperty(\"userId\");",
                  "    pm.expect(hasUser).to.be.true;",
                  "});"
